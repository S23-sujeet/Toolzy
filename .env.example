# Google AdSense publisher/client ID, e.g. ca-pub-1234567890123456
# Leave unset in local development - ads are automatically hidden when this is empty.
VITE_ADSENSE_CLIENT=

# Canonical production site URL (no trailing slash), used for canonical links,
# Open Graph/Twitter tags, and sitemap generation. Update after choosing a domain.
VITE_SITE_URL=https://www.toolzy.app

# External supporter checkout URLs. Use free hosted payment links - no
# backend/server code needed. Leave a currency unset to hide its button.
# USD: PayPal.me link (e.g. https://paypal.me/yourname/5) or a Stripe Payment Link.
VITE_SUPPORT_URL_USD=
# INR: Razorpay Payment Page link (razorpay.com/payment-pages, free to create,
# requires Indian KYC/bank account).
VITE_SUPPORT_URL_INR=
# Deprecated: old single-currency var, still used as a fallback for USD if
# VITE_SUPPORT_URL_USD is unset.
VITE_SUPPORT_URL=
